DATABASE_URL=postgresql+asyncpg://grid_pos:grid_pos@localhost:5432/grid_pos
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Daily report: Railway cron calls the API at 00:00 SGT for the previous day.
DAILY_SALES_CRON_SECRET=replace-with-a-separate-long-random-secret
DAILY_SALES_REPORT_TO=hello@hundredacre.sg
DAILY_SALES_REPORT_FROM=hello@hundredacre.sg
GMAIL_API_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_API_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_API_REFRESH_TOKEN=replace-with-google-oauth-refresh-token
