# KPay Daemon Configuration
# Copy to .env and fill in real values

# KPay terminal on local network (LAN IP + port 18080)
KPAY_TERMINAL_BASE_URL=http://192.168.1.50:18080

# KPay staging credentials
# Source: KPayPOS-POS Terminal Interface V2-20241018.xlsx
# IMPORTANT: For production, replace with production credentials
KPAY_APP_ID=your_app_id_here
KPAY_AP...ret_here

# Manager password (used for cancel/refund — RSA-encrypted by daemon)
# Default staging password: 123456
KPAY_M...rd=123456

# Railway WebSocket endpoint
# Format: wss://<railway-app>.up.railway.app/ws/daemon
# Get exact URL from Railway dashboard → your backend service → Settings → Networking
KPAY_RAILWAY_WS_URL=wss://your-app-name.up.railway.app/ws/daemon

# Shared token for daemon ↔ backend authentication
# MUST match KPAY_DAEMON_TOKEN in Railway backend environment
# Generate with: openssl rand -hex 32
KPAY...

# This outlet's UUID
# Find in Grid POS backend: GET /api/outlets, or admin portal → outlets
KPAY_O...

# Local test mode
# Set to true to skip WebSocket connection and run HTTP server on :9000
# Useful for frontend dev without the real KPay terminal
# Default: false
# KPAY_LOCAL_TEST=true

# Log level (debug, info, warn, error)
# Default: info
# KPAY_LOG_LEVEL=info

# Connection retry interval (seconds)
# Default: 5
# KPAY_RETRY_INTERVAL=5
