# KPay Daemon configuration — copy to `.env` next to kpay-daemon.exe and fill in.
# NOTE: these names must match exactly (the daemon reads these via config.go).

# This outlet's UUID (admin → Outlets, or GET /api/outlets)
OUTLET_ID=your_outlet_uuid_here

# Backend WebSocket endpoint (Railway backend, path /ws/daemon)
RAILWAY_WS_URL=wss://grid-backend-production-5fd0.up.railway.app/ws/daemon

# Shared auth token — MUST match KPAY_DAEMON_TOKEN on the Railway backend
# Generate with: openssl rand -hex 32
DAEMON_AUTH_TOKEN=your_shared_token_here

# KPay terminal on the LAN. A bare IP maps to http://<ip>:18080 automatically;
# a full http://host:port URL is also accepted.
KPAT_TERMINAL_IP=192.168.1.50

# KPay credentials (staging values were provided by KPay)
KPAT_APP_ID=your_app_id_here
KPAT_APP_SECRET=your_app_secret_here

# Manager password used for void/refund (RSA-encrypted by the daemon).
# Staging default: 123456
KPAT_MANAGER_PASSWORD=123456

# Local test mode: set to 1 to skip the WebSocket connection and expose a local
# HTTP server on :9000 (POST /kpay/sales|query|cancel|refund) for dev without
# the real terminal. Leave unset/0 for normal operation.
# KPAY_LOCAL_TEST=1
